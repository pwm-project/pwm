                        },
                        "index": false,
                        "browser": "projects/configeditor/src/main.ts",
                        "polyfills": [],
                        "tsConfig": "tsconfig.app.json",
                        "assets": [],
                        "styles": [
                            "projects/configeditor/src/html-editor.element.scss"
                        ],
                        "scripts": []
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "260kb",
                                    "maximumError": "400kb"
