{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "changepassword": {
            "projectType": "application",
            "schematics": {},
            "root": "projects/changepassword",
            "sourceRoot": "projects/changepassword/src",
            "prefix": "pwm",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:application",
                    "options": {
                        "outputPath": {
                            "base": "dist/changepassword",
                            "browser": ""
                        },
                        "index": false,
                        "browser": "projects/changepassword/src/main.ts",
                        "polyfills": [],
                        "tsConfig": "tsconfig.app.json",
                        "assets": [],
                        "styles": [],
                        "scripts": []
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "50kb",
                                    "maximumError": "100kb"
                                }
                            ],
                            "outputHashing": "none",
                            "optimization": true,
                            "sourceMap": false
                        },
                        "development": {
                            "optimization": false,
                            "sourceMap": true,
                            "namedChunks": true
                        }
                    },
                    "defaultConfiguration": "production"
                }
            }
        },
        "helpdesk": {
            "projectType": "application",
            "schematics": {},
            "root": "projects/helpdesk",
