                            "projects/helpdesk/src/helpdesk.element.scss"
                        ],
                        "scripts": []
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "100kb",
                                    "maximumError": "200kb"
                                }
                            ],
                            "outputHashing": "none",
                            "optimization": true,
                            "sourceMap": false
                        },
                        "development": {
                            "optimization": false,
                            "sourceMap": true,
                            "namedChunks": true
                        }
